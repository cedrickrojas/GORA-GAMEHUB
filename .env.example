# Leave DATABASE_URL empty ONLY for the persistent embedded PostgreSQL development mode.
DATABASE_URL=
JWT_SECRET=
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://127.0.0.1:4200,http://localhost:4200,http://127.0.0.1:3000,http://localhost:3000
APP_URL=http://127.0.0.1:4200
EMBEDDED_DB_PATH=.data/gora
SEED_DEMO=true
DEMO_PASSWORD=
ADMIN_EMAIL=
POSTGRES_PASSWORD=
# Optional: grant the first local demo user admin privileges. Disabled by default.
SEED_ADMIN=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GORA <hello@example.com>
