{
  "name": "gora",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write src server/src server/tests e2e *.json *.ts *.md *.yaml scripts",
    "dev": "concurrently -k -n API,APP \"npm run dev:server\" \"npm run dev:app\"",
    "dev:app": "ng serve --host 127.0.0.1 --port 4200",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "ng build && tsc -p server/tsconfig.json",
    "start": "node server/dist/index.js",
    "db:migrate": "tsx server/src/database/cli.ts migrate",
    "db:seed": "tsx server/src/database/cli.ts seed",
    "db:admin": "tsx server/src/database/cli.ts admin",
    "db:sports": "tsx server/src/database/cli.ts sports",
    "test": "tsx --test server/tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@angular/animations": "^20.3.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@electric-sql/pglite": "^0.3.14",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@ionic/angular": "^8.7.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ionicons": "^8.0.13",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@playwright/test": "^1.55.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
